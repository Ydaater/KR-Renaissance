guiTypes = {

	# Top bar entry. UPPER_RIGHT so the position holds at any resolution: x is measured in from the RIGHT edge, so the -272 only makes sense with this orientation.
	containerWindowType = {
		name = "ccshtool_toggle_visibility_window"
		position = { x = -272   y = 86 }
		size = { width = 100%%   height = 100%% }
		Orientation = upper_right
		moveable = no
		clipping = no

		buttonType = {
			name = "ccshtool_toggle_visibility_button"
			position = { x = 0   y = 0 }
			spriteType = "GFX_ht_open_button"
			shortcut = "ctrl+shift+h"
			pdx_tooltip = ccshtool_toggle_visibility_button_tt
		}

		instantTextBoxType = {
			name = "ccshtool_toggle_visibility_text"
			position = { x = 0 y = 8 }
			font = "hoi_16mbs"
			format = center
			text = "HT"
			maxWidth = 30
			maxHeight = 30
			fixedsize = yes
			alwaystransparent = yes
		}
	}

